# Пароль для входа в /admin
ADMIN_PASSWORD=your-secure-password

# true только когда сайт на HTTPS (иначе cookie не сохранится по HTTP)
COOKIE_SECURE=false

# URL сайта для SEO (если не задан в админке)
SITE_URL=https://parovoz39.ru

# Telegram-бот для уведомлений о бронях
# Создайте бота через @BotFather, добавьте бота в чат/группу
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=-1001234567890
